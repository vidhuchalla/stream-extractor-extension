{
  "manifest_version": 3,
  "name": "Universal Maximum Quality Downloader",
  "version": "1.0",
  "description": "Intercepts maximum quality video stream manifests.",
  "permissions": [
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}